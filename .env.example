# Port the web server listens on
PORT=3000

# Optional. Where the SQLite database file is stored.
DB_PATH=./data/todos.db

# Optional AI provider. If unset, the app falls back to its built-in
# rule-based natural-language parser, so it still works with no key.
# Any OpenAI-compatible endpoint works (OpenAI, Groq, OpenRouter, local Ollama...).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
